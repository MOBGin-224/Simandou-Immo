# SIMANDOU IMMO : variables d'environnement
#
# Copier ce fichier en .env et renseigner les valeurs.
# .env n'est jamais versionné (voir .gitignore).

# --- Base de données ---------------------------------------------------------
# En local : PostgreSQL via Docker (voir docker-compose.yml, DEC-007).
# En development, staging et production : chaîne fournie par Supabase.
DATABASE_URL=postgresql://simandou:simandou@localhost:5432/simandou_immo

# --- Application -------------------------------------------------------------
APP_URL=http://localhost:3000

# --- Variables des lots suivants ---------------------------------------------
# Déclarées ici pour mémoire, mais NON requises au Lot 1 : le code ne les lit
# pas encore. Les ajouter au schéma de validation en même temps que leur usage,
# jamais avant, sinon le démarrage exige des valeurs inventées.
#
# INTERNAL_JOB_SECRET   protection des routes /internal/* (lot Rappels)
# BETTER_AUTH_SECRET    signature des sessions (lot Authentification, DEC-032)
# BETTER_AUTH_URL       URL canonique utilisée par Better Auth
