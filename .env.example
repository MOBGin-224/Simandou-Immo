# SIMANDOU IMMO : variables d'environnement
#
# Copier ce fichier en .env et renseigner les valeurs.
# .env n'est jamais versionné (voir .gitignore).

# --- Base de données ---------------------------------------------------------
# En local : PostgreSQL via Docker (voir docker-compose.yml, DEC-007).
# En development, staging et production : chaîne fournie par Supabase.
DATABASE_URL=postgresql://simandou:simandou@localhost:5432/simandou_immo

# --- Application -------------------------------------------------------------
APP_URL=http://localhost:3000

# --- Authentification (DEC-032, ADR-006) -------------------------------------
# Signature des sessions. 32 caractères minimum, aléatoire, propre à chaque
# environnement. Une rotation invalide toutes les sessions en cours.
# Générer avec : node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
BETTER_AUTH_SECRET=remplacer-par-un-secret-aleatoire-de-32-caracteres-minimum

# URL canonique vue par le navigateur. Vaut normalement APP_URL.
BETTER_AUTH_URL=http://localhost:3000

# --- Invitations (DEC-045) ---------------------------------------------------
# Durée de validité d'un lien d'invitation, en jours, de 1 à 30. Facultative :
# 7 jours si elle est absente. Calculée à l'émission puis figée dans la ligne :
# la modifier n'altère pas les invitations déjà émises.
INVITATION_TTL_DAYS=7

# --- Variables des lots suivants ---------------------------------------------
# Déclarées ici pour mémoire, mais NON requises : le code ne les lit pas encore.
# Les ajouter au schéma de validation en même temps que leur usage, jamais
# avant, sinon le démarrage exige des valeurs inventées.
#
# INTERNAL_JOB_SECRET   protection des routes /internal/* (lot Rappels)
